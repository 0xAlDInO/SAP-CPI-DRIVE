<mvc:View controllerName="poc.cpi.ral.drivefilemanager.controller.Drive"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:card="sap.f.cards"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">
    <Page id="page" title="{i18n>title}" titleAlignment="Start">
        <headerContent>
            <Button icon="sap-icon://refresh" tooltip="{i18n>btnRefresh}" press=".onRefresh"/>
        </headerContent>
        <content>
            <IconTabBar id="iconTabBar" selectedKey="drive" select=".onTabSelect" expandable="false" applyContentPadding="false">
                <items>
                    <IconTabFilter icon="sap-icon://folder-blank" text="{i18n>tabDrive}" key="drive">
                        <VBox class="sapUiSmallMargin">
                            <!-- Breadcrumbs / Folder Header Navigation -->
                            <HBox alignmentBar="true" justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                                <Breadcrumbs id="breadcrumbs" currentLocationText="{i18n>rootFolderName}">
                                </Breadcrumbs>
                                <HBox>
                                    <Button id="btnUp" icon="sap-icon://navigation-up-arrow" text="{i18n>btnBackToParent}" press=".onNavUp" enabled="false" class="sapUiTinyMarginEnd"/>
                                    <Button icon="sap-icon://upload" text="{i18n>btnUpload}" type="Emphasized" press=".onOpenUploadDialog"/>
                                </HBox>
                            </HBox>

                            <!-- Search and Table -->
                            <Table id="filesTable"
                                items="{path: 'drive>/files'}"
                                noDataText="Aucun fichier trouvé"
                                growing="true"
                                growingThreshold="50"
                                class="sapFDynamicPageContent">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="{i18n>tabDrive}" level="H2"/>
                                        <ToolbarSpacer/>
                                        <SearchField width="30%" placeholder="{i18n>toolbarSearchPlaceholder}" search=".onSearchLive" liveChange=".onSearchLive"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column width="3rem" hAlign="Center">
                                        <Text text="{i18n>colType}"/>
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>colName}"/>
                                    </Column>
                                    <Column demandPopin="true" minScreenWidth="Tablet">
                                        <Text text="{i18n>colSize}"/>
                                    </Column>
                                    <Column demandPopin="true" minScreenWidth="Tablet">
                                        <Text text="{i18n>colModifiedTime}"/>
                                    </Column>
                                    <Column width="4rem" hAlign="Center">
                                        <Text text="{i18n>colActions}"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem type="Active" press=".onItemPress">
                                        <cells>
                                            <core:Icon src="{= ${drive>isFolder} ? 'sap-icon://folder-blank' : (${drive>mimeType} === 'application/pdf' ? 'sap-icon://pdf-attachment' : (${drive>mimeType} === 'image/png' || ${drive>mimeType} === 'image/jpeg' ? 'sap-icon://attachment-photo' : 'sap-icon://document')) }"
                                                       color="{= ${drive>isFolder} ? '#E89D00' : 'Default' }"/>
                                            <ObjectIdentifier title="{drive>name}" text="{drive>id}"/>
                                            <Text text="{path: 'drive>size', formatter: '.formatFileSize'}"/>
                                            <Text text="{path: 'drive>modifiedTime', formatter: '.formatDate'}"/>
                                            <Button icon="sap-icon://overflow" type="Transparent" press=".onOpenActionSheet"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter icon="sap-icon://view" text="{i18n>tabDashboard}" key="dashboard">
                        <VBox class="sapUiSmallMargin">
                            <!-- Summary Tiles -->
                            <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                                <GenericTile class="sapUiTinyMarginEnd sapUiTinyMarginBottom" header="{i18n>dashboardTotalItems}" frameType="OneByOne">
                                    <TileContent>
                                        <NumericContent value="{stats>/totalItems}" icon="sap-icon://documents"/>
                                    </TileContent>
                                </GenericTile>
                                <GenericTile class="sapUiTinyMarginEnd sapUiTinyMarginBottom" header="{i18n>dashboardTotalFiles}" frameType="OneByOne">
                                    <TileContent>
                                        <NumericContent value="{stats>/totalFiles}" icon="sap-icon://document" valueColor="Good"/>
                                    </TileContent>
                                </GenericTile>
                                <GenericTile class="sapUiTinyMarginEnd sapUiTinyMarginBottom" header="{i18n>dashboardTotalFolders}" frameType="OneByOne">
                                    <TileContent>
                                        <NumericContent value="{stats>/totalFolders}" icon="sap-icon://folder-blank" valueColor="Critical"/>
                                    </TileContent>
                                </GenericTile>
                            </HBox>

                            <!-- Charts & Breakdown Cards -->
                            <l:Grid defaultSpan="XL6 L6 M12 S12">
                                <Panel headerText="{i18n>dashboardFileTypeDist}" expandable="false" class="sapUiTinyMarginBottom">
                                    <List items="{stats>/byType}">
                                        <StandardListItem title="{stats>category}" number="{stats>count}" icon="{stats>icon}"/>
                                    </List>
                                </Panel>

                                <Panel headerText="{i18n>dashboardModDateDist}" expandable="false" class="sapUiTinyMarginBottom">
                                    <List items="{stats>/byDate}">
                                        <StandardListItem title="{stats>period}" number="{stats>count}" icon="sap-icon://history"/>
                                    </List>
                                </Panel>
                            </l:Grid>
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
